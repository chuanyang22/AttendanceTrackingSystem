@model AttendanceTrackingSystem.Models.ViewModels.StudentAttendanceSummaryViewModel
@{
    ViewData["Title"] = "Student Attendance History";
}

<h1>Student Attendance History</h1>

<form asp-action="StudentHistory" method="get" class="row g-3 mb-4">
    <div class="col-md-6">
        <select name="studentId" class="form-select" asp-items="ViewBag.StudentId" onchange="this.form.submit()">
            <option value="">-- Select Student --</option>
        </select>
    </div>
</form>

@if (Model != null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h3>@Model.StudentName <small class="text-muted">(@Model.StudentEmail)</small></h3>
            <hr />
            <div class="row text-center">
                <div class="col-md-3">
                    <h4>@Model.TotalSessions</h4>
                    <span class="text-muted">Total Sessions</span>
                </div>
                <div class="col-md-3">
                    <h4 class="text-success">@Model.PresentCount</h4>
                    <span class="text-muted">Present</span>
                </div>
                <div class="col-md-3">
                    <h4 class="text-danger">@Model.AbsentCount</h4>
                    <span class="text-muted">Absent</span>
                </div>
                <div class="col-md-3">
                    @{
                        var pctClass = Model.AttendancePercentage >= 80 ? "bg-success" : (Model.AttendancePercentage >= 60 ? "bg-warning text-dark" : "bg-danger");
                    }
                    <h4><span class="badge @pctClass">@Model.AttendancePercentage%</span></h4>
                    <span class="text-muted">Attendance Rate</span>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Class</th>
                <th>Status</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model.Records)
            {
                <tr>
                    <td>@record.Date.ToString("yyyy-MM-dd")</td>
                    <td>@record.ClassName</td>
                    <td>
                        <span class="badge @(record.Status == "Present" ? "bg-success" : record.Status == "Absent" ? "bg-danger" : record.Status == "Late" ? "bg-warning text-dark" : "bg-info")">
                            @record.Status
                        </span>
                    </td>
                    <td>@record.Remarks</td>
                </tr>
            }
        </tbody>
    </table>
}