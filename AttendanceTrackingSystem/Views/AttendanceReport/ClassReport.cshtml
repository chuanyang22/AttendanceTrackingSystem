@model AttendanceTrackingSystem.Models.ViewModels.ClassAttendanceReportViewModel
@{
    ViewData["Title"] = "Class Attendance Report";
}

<h1>Class Attendance Report</h1>

<form asp-action="ClassReport" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <select name="classId" class="form-select" asp-items="ViewBag.ClassId">
            <option value="">-- Select Class --</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="month" class="form-select">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == (int)ViewData["SelectedMonth"]!)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <input type="number" name="year" class="form-control" value="@ViewData["SelectedYear"]" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

@if (Model != null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Class: @Model.ClassName (Teacher: @Model.TeacherName)</h3>
        <a asp-action="PrintReport" asp-route-classId="@Model.ClassId" asp-route-month="@Model.Month" asp-route-year="@Model.Year" target="_blank" class="btn btn-outline-secondary">ðŸ–¨ï¸ Printable PDF View</a>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Student Name</th>
                <th>Total Sessions</th>
                <th>Present</th>
                <th>Excused</th>
                <th>Absent</th>
                <th>Attendance Rate (%)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.StudentSummaries)
            {
                <tr>
                    <td>@s.StudentName</td>
                    <td>@s.TotalSessions</td>
                    <td><span class="text-success fw-bold">@s.PresentCount</span></td>
                    <td><span class="text-warning fw-bold">@s.ExcusedCount</span></td>
                    <td><span class="text-danger fw-bold">@s.AbsentCount</span></td>
                    <td>
                        @{
                            var badgeClass = s.AttendancePercentage >= 80 ? "bg-success" : (s.AttendancePercentage >= 60 ? "bg-warning text-dark" : "bg-danger");
                        }
                        <span class="badge @badgeClass fs-6">@s.AttendancePercentage%</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
