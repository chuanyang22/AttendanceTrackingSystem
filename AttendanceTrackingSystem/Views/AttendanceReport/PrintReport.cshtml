@model AttendanceTrackingSystem.Models.ViewModels.ClassAttendanceReportViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Attendance Report - @Model.ClassName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        @@media print {
            .no-print { display: none; }
        }
    </style>
</head>
<body class="p-4" onload="window.print()">
    <div class="no-print mb-3">
        <button onclick="window.print()" class="btn btn-primary">Print / Save as PDF</button>
        <button onclick="window.close()" class="btn btn-secondary">Close</button>
    </div>

    <h2>Attendance Summary Report</h2>
    <p><strong>Class:</strong> @Model.ClassName | <strong>Teacher:</strong> @Model.TeacherName</p>
    <p><strong>Period:</strong> @Model.Month / @Model.Year | <strong>Total Sessions:</strong> @Model.TotalSessions</p>
    <hr />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Student Name</th>
                <th>Email</th>
                <th>Present</th>
                <th>Late</th>
                <th>Absent</th>
                <th>Excused</th>
                <th>Attendance Rate (%)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.StudentSummaries)
            {
                <tr>
                    <td>@s.StudentName</td>
                    <td>@s.StudentEmail</td>
                    <td>@s.PresentCount</td>
                    <td>@s.LateCount</td>
                    <td>@s.AbsentCount</td>
                    <td>@s.ExcusedCount</td>
                    <td>@s.AttendancePercentage%</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>