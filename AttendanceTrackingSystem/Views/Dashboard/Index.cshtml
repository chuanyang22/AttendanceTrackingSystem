@model AttendanceTrackingSystem.Models.ViewModels.DashboardViewModel

<style>
    .quick-access-btn:hover small.text-muted {
        color: rgba(255, 255, 255, 0.9) !important;
    }
</style>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold">Welcome back, @Model.FullName!</h2>
                <p class="text-muted">
            Role: <span class="badge bg-secondary">@Model.Role</span>
            @if (User.IsInRole("Student"))
            {
                <span>| Overall Attendance Rate: <strong>@Model.OverallAttendanceRate%</strong></span>
            }
        </p>
    </div>
</div>

@if (User.IsInRole("Student"))
{
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-light p-4 rounded-3">
                <h5 class="fw-bold mb-3"><i class="bi bi-upc-scan me-2"></i>Quick Attendance Check-In</h5>
                <form id="checkInForm" asp-controller="Attendance" asp-action="PinCheckIn" method="post" class="d-flex gap-2">
                    <input type="hidden" id="latitude" name="latitude" />
                    <input type="hidden" id="longitude" name="longitude" />
                    <input type="text" name="pinCode" class="form-control form-control-lg text-center fw-bold" placeholder="Enter 6-Digit PIN" maxlength="6" pattern="\d{6}" required style="letter-spacing: 5px;" />
                    <button type="submit" class="btn btn-primary btn-lg px-4">Submit</button>
                </form>
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="text-danger mt-2 small">@TempData["ErrorMessage"]</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="text-success mt-2 small">@TempData["SuccessMessage"]</div>
                }
            </div>
        </div>
    </div>
}

@if (!User.IsInRole("Student"))
{
    var cardColClass = "col-md-4";

    <!-- Quick Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="@cardColClass">
            <div class="card shadow-sm border-0 bg-primary text-white p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 text-uppercase">@(User.IsInRole("Teacher") ? "My Students" : "Students")</h6>
                        <h2 class="mt-2 mb-0 fw-bold">@Model.TotalStudents</h2>
                    </div>
                    <i class="bi bi-people fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="@cardColClass">
            <div class="card shadow-sm border-0 bg-success text-white p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 text-uppercase">@(User.IsInRole("Teacher") ? "My Classes" : "Classes")</h6>
                        <h2 class="mt-2 mb-0 fw-bold">@Model.TotalClasses</h2>
                    </div>
                    <i class="bi bi-easel fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
                @if (User.IsInRole("Teacher"))
        {
            <div class="@cardColClass">
                <div class="card shadow-sm border-0 bg-warning text-dark p-3 rounded-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 text-uppercase">@(User.IsInRole("Teacher") ? "My Sessions" : "Sessions")</h6>
                            <h2 class="mt-2 mb-0 fw-bold">@Model.TotalSessions</h2>
                        </div>
                        <i class="bi bi-calendar-check fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        }
        @* SYSTEM USERS IS ONLY VISIBLE TO ADMINISTRATORS - TEACHERS CANNOT SEE THIS *@
        @if (User.IsInRole("Admin"))
        {
            <div class="@cardColClass">
                <div class="card shadow-sm border-0 bg-dark text-white p-3 rounded-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 text-uppercase">System Users</h6>
                            <h2 class="mt-2 mb-0 fw-bold">@Model.TotalUsers</h2>
                        </div>
                        <i class="bi bi-person-badge fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Dedicated Teacher Attendance PIN Codes Section *@
    @if (User.IsInRole("Teacher") && Model.TeacherTodaySessions != null && Model.TeacherTodaySessions.Any())
    {
        <div class="card shadow-sm border-0 mb-4 rounded-3 p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-key-fill me-2"></i>Today's Class Sessions &amp; Attendance PINs
                </h5>
                <small class="text-muted">Students can enter the 6-digit PIN on their portal to mark attendance.</small>
            </div>
            <div class="row g-3">
                @foreach (var session in Model.TeacherTodaySessions)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-primary border-2 p-3 rounded-3 h-100 bg-light">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">@session.ClassName</h6>
                                    <span class="badge bg-secondary">@session.SessionType</span>
                                </div>
                                <span class="badge bg-success">
                                    <i class="bi bi-person-check me-1"></i>@session.PresentCount / @session.TotalEnrolled Present
                                </span>
                            </div>
                            
                            @if (session.StartTime.HasValue && session.EndTime.HasValue)
                            {
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-clock me-1"></i>@(DateTime.Today.Add(session.StartTime.Value).ToString("h:mm tt")) - @(DateTime.Today.Add(session.EndTime.Value).ToString("h:mm tt"))
                                </p>
                            }

                            <div class="bg-white p-2 rounded text-center border my-2">
                                <div class="small text-muted fw-semibold">6-Digit Attendance Code</div>
                                <div class="fs-2 fw-bold text-primary tracking-wider" style="letter-spacing: 5px;">@session.PinCode</div>
                            </div>

                            <div class="d-flex gap-2 mt-auto">
                                <a asp-controller="Attendance" asp-action="QRCode" asp-route-id="@session.SessionId" class="btn btn-primary btn-sm flex-fill">
                                    <i class="bi bi-display me-1"></i> Display PIN
                                </a>
                                <a asp-controller="Attendance" asp-action="Mark" asp-route-id="@session.SessionId" class="btn btn-outline-success btn-sm flex-fill">
                                    <i class="bi bi-check2-square me-1"></i> Roster
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@if (User.IsInRole("Student"))
{
    <h4 class="fw-bold mb-3">My Classes</h4>
    <div class="row g-3 mb-4">
        @foreach(var classStat in Model.ClassStats)
        {
            <div class="col-md-4">
                <div class="card shadow-sm border-0 p-3 rounded-3 h-100 position-relative">
                    <h5 class="fw-bold text-primary mb-3 text-truncate" title="@classStat.ClassName">@classStat.ClassName</h5>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-success fw-semibold"><i class="bi bi-check-circle me-1"></i> Present:</span>
                        <span class="fw-bold">@classStat.Present</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-danger fw-semibold"><i class="bi bi-x-circle me-1"></i> Absent:</span>
                        <span class="fw-bold">@classStat.Absent</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-warning text-dark fw-semibold"><i class="bi bi-exclamation-circle me-1"></i> Excused:</span>
                        <span class="fw-bold">@classStat.Excused</span>
                    </div>
                    <hr class="mt-0 mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold">Attendance Rate:</span>
                        <span class="badge @(classStat.AttendancePercentage >= 80 ? "bg-success" : "bg-danger") fs-6">
                            @classStat.AttendancePercentage%
                        </span>
                    </div>
                    @if (classStat.AttendancePercentage < 80)
                    {
                        <div class="alert alert-danger mb-0 p-2 text-center" style="font-size: 0.85rem;">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> 
                            <strong>&lt;80%</strong> - Cannot sit for final exam without appeal
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (!User.IsInRole("Student"))
{
        <!-- Charts Row -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 p-4 h-100">
                    <h5 class="fw-bold mb-4 text-primary"><i class="bi bi-pie-chart-fill me-2"></i>Overall Attendance Rate</h5>
                    <div style="height: 300px; position: relative;">
                        <canvas id="attendancePieChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm border-0 p-4 h-100">
                    <h5 class="fw-bold mb-4 text-success"><i class="bi bi-bar-chart-line-fill me-2"></i>Attendance Breakdown</h5>
                    <div style="height: 300px; position: relative;">
                        <canvas id="attendanceBarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
    {
        <!-- Admin Quick Access & Recent -->
        <div class="row g-4 mb-4">
            <div class="col-md-7">
                <div class="card shadow-sm border-0 p-4 h-100">
                    <h5 class="fw-bold mb-4 text-primary"><i class="bi bi-grid-fill me-2"></i>Quick Access Features</h5>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <a asp-controller="User" asp-action="Index" class="btn btn-outline-dark quick-access-btn w-100 py-3 text-start d-flex align-items-center h-100 rounded-3">
                                <div class="bg-dark text-white rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;"><i class="bi bi-people fs-4"></i></div>
                                <div><div class="fw-bold fs-6">Manage Users</div><small class="text-muted">Add or edit accounts</small></div>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a asp-controller="Class" asp-action="Index" class="btn btn-outline-success quick-access-btn w-100 py-3 text-start d-flex align-items-center h-100 rounded-3">
                                <div class="bg-success text-white rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;"><i class="bi bi-easel fs-4"></i></div>
                                <div><div class="fw-bold fs-6">Manage Classes</div><small class="text-muted">View all subjects</small></div>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a asp-controller="Timetable" asp-action="Index" class="btn btn-outline-primary quick-access-btn w-100 py-3 text-start d-flex align-items-center h-100 rounded-3">
                                <div class="bg-primary text-white rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;"><i class="bi bi-calendar3 fs-4"></i></div>
                                <div><div class="fw-bold fs-6">Timetable</div><small class="text-muted">View Timetable</small></div>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a asp-controller="AttendanceReport" asp-action="ClassReport" class="btn btn-outline-danger quick-access-btn w-100 py-3 text-start d-flex align-items-center h-100 rounded-3">
                                <div class="bg-danger text-white rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width:48px;height:48px;"><i class="bi bi-file-earmark-bar-graph fs-4"></i></div>
                                <div><div class="fw-bold fs-6">Reports</div><small class="text-muted">Generate PDF logs</small></div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-5">
                <div class="card shadow-sm border-0 p-4 h-100">
                    <h5 class="fw-bold mb-4 text-warning"><i class="bi bi-clock-history me-2"></i>Recently Visited</h5>
                    <div id="recentPagesContainer" class="list-group list-group-flush">
                        <div class="text-center text-muted py-4">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div> Loading history...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <!-- Add Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const checkInForm = document.getElementById("checkInForm");
            if (checkInForm) {
                checkInForm.addEventListener("submit", function(e) {
                    if (navigator.geolocation) {
                        e.preventDefault();
                        navigator.geolocation.getCurrentPosition(function(position) {
                            document.getElementById("latitude").value = position.coords.latitude;
                            document.getElementById("longitude").value = position.coords.longitude;
                            checkInForm.submit();
                        }, function(error) {
                            console.warn("Geolocation disabled or denied, submitting without location.");
                            checkInForm.submit();
                        });
                    }
                });
            }

            const container = document.getElementById("recentPagesContainer");
            if (container) {
                try {
                    let history = JSON.parse(localStorage.getItem("ats_recent_pages") || "[]");
                    
                    if (history.length === 0) {
                        container.innerHTML = `<div class="text-center text-muted py-4"><i class="bi bi-journal-x fs-1 d-block mb-2 opacity-25"></i>No recent pages yet.</div>`;
                    } else {
                        container.innerHTML = history.map(p => 
                            `<a href="` + p.url + `" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 border-bottom">
                                <i class="bi bi-link-45deg fs-4 text-muted me-3"></i>
                                <div>
                                    <div class="fw-semibold text-dark">` + p.title + `</div>
                                    <small class="text-muted">` + p.url + `</small>
                                </div>
                                <i class="bi bi-chevron-right ms-auto text-muted opacity-50"></i>
                            </a>`
                        ).join('');
                    }
                } catch (e) {
                    container.innerHTML = `<div class="text-danger py-2">Could not load history.</div>`;
                }
            }
        });
    </script>
    <script>
        var present = @Model.PresentCount;
        var absent = @Model.AbsentCount;
        var excused = @Model.ExcusedCount;

        // Pie Chart
        var pieChartEl = document.getElementById('attendancePieChart');
        if (pieChartEl) {
            new Chart(pieChartEl, {
                type: 'doughnut',
                data: {
                    labels: ['Present', 'Absent', 'Excused'],
                    datasets: [{
                        data: [present, absent, excused],
                        backgroundColor: ['#198754', '#dc3545', '#ffc107'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }

        // Bar Chart (Only for non-students)
        var barChartEl = document.getElementById('attendanceBarChart');
        if (barChartEl) {
            new Chart(barChartEl, {
                type: 'bar',
                data: {
                    labels: ['Present', 'Absent', 'Excused'],
                    datasets: [{
                        label: 'Total Headcount',
                        data: [present, absent, excused],
                        backgroundColor: ['#198754', '#dc3545', '#ffc107']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }
    </script>
}










