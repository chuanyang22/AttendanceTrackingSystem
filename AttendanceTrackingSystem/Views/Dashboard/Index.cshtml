@model AttendanceTrackingSystem.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold">Welcome back, @Model.FullName!</h2>
        <p class="text-muted">Role: <span class="badge bg-secondary">@Model.Role</span> | Overall Attendance Rate: <strong>@Model.OverallAttendanceRate%</strong></p>
    </div>
</div>

@if (User.IsInRole("Student"))
{
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-light p-4 rounded-3">
                <h5 class="fw-bold mb-3"><i class="bi bi-upc-scan me-2"></i>Quick Attendance Check-In</h5>
                <form asp-controller="Attendance" asp-action="PinCheckIn" method="post" class="d-flex gap-2">
                    <input type="text" name="pinCode" class="form-control form-control-lg text-center fw-bold" placeholder="Enter 6-Digit PIN" maxlength="6" pattern="\d{6}" required style="letter-spacing: 5px;" />
                    <button type="submit" class="btn btn-primary btn-lg px-4">Submit</button>
                </form>
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="text-danger mt-2 small">@TempData["ErrorMessage"]</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="text-success mt-2 small">@TempData["SuccessMessage"]</div>
                }
            </div>
        </div>
    </div>
}

@if (!User.IsInRole("Student"))
{
    var cardColClass = User.IsInRole("Admin") ? "col-md-3" : "col-md-4";

    <!-- Quick Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="@cardColClass">
            <div class="card shadow-sm border-0 bg-primary text-white p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 text-uppercase">@(User.IsInRole("Teacher") ? "My Students" : "Students")</h6>
                        <h2 class="mt-2 mb-0 fw-bold">@Model.TotalStudents</h2>
                    </div>
                    <i class="bi bi-people fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="@cardColClass">
            <div class="card shadow-sm border-0 bg-success text-white p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 text-uppercase">@(User.IsInRole("Teacher") ? "My Classes" : "Classes")</h6>
                        <h2 class="mt-2 mb-0 fw-bold">@Model.TotalClasses</h2>
                    </div>
                    <i class="bi bi-easel fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="@cardColClass">
            <div class="card shadow-sm border-0 bg-warning text-dark p-3 rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 text-uppercase">@(User.IsInRole("Teacher") ? "My Sessions" : "Sessions")</h6>
                        <h2 class="mt-2 mb-0 fw-bold">@Model.TotalSessions</h2>
                    </div>
                    <i class="bi bi-calendar-check fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        @* SYSTEM USERS IS ONLY VISIBLE TO ADMINISTRATORS - TEACHERS CANNOT SEE THIS *@
        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-dark text-white p-3 rounded-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 text-uppercase">System Users</h6>
                            <h2 class="mt-2 mb-0 fw-bold">@Model.TotalUsers</h2>
                        </div>
                        <i class="bi bi-person-badge fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Dedicated Teacher Attendance PIN Codes Section *@
    @if (User.IsInRole("Teacher") && Model.TeacherTodaySessions != null && Model.TeacherTodaySessions.Any())
    {
        <div class="card shadow-sm border-0 mb-4 rounded-3 p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-key-fill me-2"></i>Today's Class Sessions &amp; Attendance PINs
                </h5>
                <small class="text-muted">Students can enter the 6-digit PIN on their portal to mark attendance.</small>
            </div>
            <div class="row g-3">
                @foreach (var session in Model.TeacherTodaySessions)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-primary border-2 p-3 rounded-3 h-100 bg-light">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">@session.ClassName</h6>
                                    <span class="badge bg-secondary">@session.SessionType</span>
                                </div>
                                <span class="badge bg-success">
                                    <i class="bi bi-person-check me-1"></i>@session.PresentCount / @session.TotalEnrolled Present
                                </span>
                            </div>
                            
                            @if (session.StartTime.HasValue && session.EndTime.HasValue)
                            {
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-clock me-1"></i>@(DateTime.Today.Add(session.StartTime.Value).ToString("h:mm tt")) - @(DateTime.Today.Add(session.EndTime.Value).ToString("h:mm tt"))
                                </p>
                            }

                            <div class="bg-white p-2 rounded text-center border my-2">
                                <div class="small text-muted fw-semibold">6-Digit Attendance Code</div>
                                <div class="fs-2 fw-bold text-primary tracking-wider" style="letter-spacing: 5px;">@session.PinCode</div>
                            </div>

                            <div class="d-flex gap-2 mt-auto">
                                <a asp-controller="Attendance" asp-action="QRCode" asp-route-id="@session.SessionId" class="btn btn-primary btn-sm flex-fill">
                                    <i class="bi bi-display me-1"></i> Display PIN
                                </a>
                                <a asp-controller="Attendance" asp-action="Mark" asp-route-id="@session.SessionId" class="btn btn-outline-success btn-sm flex-fill">
                                    <i class="bi bi-check2-square me-1"></i> Roster
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@if (User.IsInRole("Student"))
{
    <h4 class="fw-bold mb-3">My Classes</h4>
    <div class="row g-3 mb-4">
        @foreach(var classStat in Model.ClassStats)
        {
            <div class="col-md-4">
                <div class="card shadow-sm border-0 p-3 rounded-3 h-100 position-relative">
                    <h5 class="fw-bold text-primary mb-3 text-truncate" title="@classStat.ClassName">@classStat.ClassName</h5>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-success fw-semibold"><i class="bi bi-check-circle me-1"></i> Present:</span>
                        <span class="fw-bold">@classStat.Present</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-danger fw-semibold"><i class="bi bi-x-circle me-1"></i> Absent:</span>
                        <span class="fw-bold">@classStat.Absent</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-warning text-dark fw-semibold"><i class="bi bi-exclamation-circle me-1"></i> Excused:</span>
                        <span class="fw-bold">@classStat.Excused</span>
                    </div>
                    <hr class="mt-0 mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold">Attendance Rate:</span>
                        <span class="badge @(classStat.AttendancePercentage >= 80 ? "bg-success" : "bg-danger") fs-6">
                            @classStat.AttendancePercentage%
                        </span>
                    </div>
                    @if (classStat.AttendancePercentage < 80)
                    {
                        <div class="alert alert-danger mb-0 p-2 text-center" style="font-size: 0.85rem;">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> 
                            <strong>&lt;80%</strong> - Cannot sit for final exam without appeal
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (!User.IsInRole("Student"))
{
    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-3 h-100">
                <h5 class="card-title fw-bold mb-3">Overall Attendance Distribution</h5>
                <div style="height: 280px; position: relative;">
                    <canvas id="attendancePieChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-3 h-100">
                <h5 class="card-title fw-bold mb-3">Attendance Overview Comparison</h5>
                <div style="height: 280px; position: relative;">
                    <canvas id="attendanceBarChart"></canvas>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const present = @Model.PresentCount;
        const absent = @Model.AbsentCount;
        const excused = @Model.ExcusedCount;

        // Doughnut / Pie Chart
        var pieChartEl = document.getElementById('attendancePieChart');
        if (pieChartEl) {
            new Chart(pieChartEl, {
                type: 'doughnut',
                data: {
                    labels: ['Present', 'Absent', 'Excused'],
                    datasets: [{
                        data: [present, absent, excused],
                        backgroundColor: ['#198754', '#dc3545', '#ffc107']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });
        }

        // Bar Chart (Only for non-students)
        var barChartEl = document.getElementById('attendanceBarChart');
        if (barChartEl) {
            new Chart(barChartEl, {
                type: 'bar',
                data: {
                    labels: ['Present', 'Absent', 'Excused'],
                    datasets: [{
                        label: 'Total Headcount',
                        data: [present, absent, excused],
                        backgroundColor: ['#198754', '#dc3545', '#ffc107']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }
    </script>
}