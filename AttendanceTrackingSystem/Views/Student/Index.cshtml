@model IEnumerable<AttendanceTrackingSystem.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>

@if (TempData["BatchSuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["BatchSuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add New Student</a>
    <a asp-action="BatchCreate" class="btn btn-outline-primary">+ Add Multiple Students</a>
</p>

<div class="mb-3">
    <input type="text" id="searchBox" class="form-control" value="@ViewData["CurrentFilter"]" placeholder="Search by name or email..." />
</div>

<div id="studentTableContainer">
    @await Html.PartialAsync("_StudentTable", Model)
</div>

@section Scripts {
    <script>
        (function () {
            const searchBox = document.getElementById('searchBox');
            const container = document.getElementById('studentTableContainer');
            let debounceTimer;

            searchBox.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    const query = searchBox.value;
                    const url = '@Url.Action("Index", "Student")' + '?searchString=' + encodeURIComponent(query);

                    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(response => response.text())
                        .then(html => {
                            container.innerHTML = html;
                            const newUrl = query
                                ? '@Url.Action("Index", "Student")' + '?searchString=' + encodeURIComponent(query)
                                : '@Url.Action("Index", "Student")';
                            history.replaceState(null, '', newUrl);
                        })
                        .catch(err => console.error('Search failed:', err));
                }, 300);
            });
        })();
    </script>
}