@model AttendanceTrackingSystem.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<h1>Student Details</h1>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Phone</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>
</dl>

<h3>Enrolled Classes</h3>
<p>
    <a asp-controller="Enrollment" asp-action="Create" asp-route-studentId="@Model.StudentId" class="btn btn-primary btn-sm">+ Enroll in Class</a>
</p>
@if (Model.Enrollments != null && Model.Enrollments.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Class Name</th>
                <th>Enroll Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var enrollment in Model.Enrollments)
            {
                <tr>
                    <td>@enrollment.SchoolClass?.ClassName</td>
                    <td>@enrollment.EnrollDate.ToShortDateString()</td>
                    <td>
                        <a asp-controller="Enrollment" asp-action="Delete" asp-route-id="@enrollment.EnrollmentId">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Not enrolled in any classes yet.</p>
}

<a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>