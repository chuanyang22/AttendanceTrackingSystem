@model IEnumerable<AttendanceTrackingSystem.Models.Student>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>
                    @{
                        var badgeClass = item.Status switch
                        {
                            "Active" => "badge bg-success",
                            "Inactive" => "badge bg-secondary",
                            "Graduated" => "badge bg-info",
                            _ => "badge bg-light"
                        };
                    }
                    <span class="@badgeClass">@item.Status</span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-primary">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No students found.</td>
            </tr>
        }
    </tbody>
</table>