@model IEnumerable<AttendanceTrackingSystem.Models.Student>

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>
                <a href="#" class="ajax-link text-decoration-none text-dark" data-sort="@ViewData["NameSortParm"]" data-page="@ViewData["PageIndex"]">Name <i class="bi bi-arrow-down-up small text-muted"></i></a>
            </th>
            <th>
                <a href="#" class="ajax-link text-decoration-none text-dark" data-sort="@ViewData["EmailSortParm"]" data-page="@ViewData["PageIndex"]">Email <i class="bi bi-arrow-down-up small text-muted"></i></a>
            </th>
            <th>Phone</th>
            <th>
                <a href="#" class="ajax-link text-decoration-none text-dark" data-sort="@ViewData["StatusSortParm"]" data-page="@ViewData["PageIndex"]">Status <i class="bi bi-arrow-down-up small text-muted"></i></a>
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>
                    @{
                        var badgeClass = item.Status switch
                        {
                            "Active" => "badge bg-success",
                            "Inactive" => "badge bg-secondary",
                            "Graduated" => "badge bg-info",
                            _ => "badge bg-light"
                        };
                    }
                    <span class="@badgeClass">@item.Status</span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Details</a>
                    <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">No students found matching your criteria.</td>
            </tr>
        }
    </tbody>
</table>

@{
    int totalPages = ViewData["TotalPages"] != null ? (int)ViewData["TotalPages"] : 1;
    int pageIndex = ViewData["PageIndex"] != null ? (int)ViewData["PageIndex"] : 1;
}

@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center mt-4">
            <li class="page-item @(pageIndex == 1 ? "disabled" : "")">
                <a class="page-link ajax-link" href="#" data-sort="@ViewData["CurrentSort"]" data-page="@(pageIndex - 1)">Previous</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == pageIndex ? "active" : "")">
                    <a class="page-link ajax-link" href="#" data-sort="@ViewData["CurrentSort"]" data-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(pageIndex == totalPages ? "disabled" : "")">
                <a class="page-link ajax-link" href="#" data-sort="@ViewData["CurrentSort"]" data-page="@(pageIndex + 1)">Next</a>
            </li>
        </ul>
    </nav>
}