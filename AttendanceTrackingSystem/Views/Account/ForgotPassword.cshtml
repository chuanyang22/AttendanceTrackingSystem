@model AttendanceTrackingSystem.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-md-5">
        <div class="card card-custom p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3 text-white"
                     style="width: 56px; height: 56px; background: linear-gradient(135deg, #6366f1, #4f46e5); box-shadow: 0 10px 20px rgba(99,102,241,0.3);">
                    <i class="bi bi-key-fill fs-3"></i>
                </div>
                <h3 class="fw-bold tracking-tight">Forgot Password?</h3>
                <p class="text-muted small">Enter your email to initiate a password reset.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 rounded-3 py-2 small shadow-sm">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div class="form-floating mb-4">
                    <input asp-for="Email" class="form-control rounded-3" placeholder="name@example.com" autofocus required />
                    <label asp-for="Email"><i class="bi bi-envelope text-muted me-1"></i> Email Address</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-gradient w-100 py-3 rounded-3 shadow-sm mb-3">
                    Continue to Reset <i class="bi bi-arrow-right ms-1"></i>
                </button>

                <div class="text-center">
                    <a asp-action="Login" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}