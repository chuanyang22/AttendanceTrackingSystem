@model AttendanceTrackingSystem.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="card card-custom p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3 text-white"
                     style="width: 56px; height: 56px; background: var(--primary-gradient); box-shadow: 0 10px 20px rgba(99,102,241,0.3);">
                    <i class="bi bi-person-lock fs-3"></i>
                </div>
                <h3 class="fw-bold tracking-tight">Welcome Back</h3>
                <p class="text-muted small">Enter your credentials to access ATS</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 rounded-3 py-2 small shadow-sm">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control rounded-3" placeholder="name@example.com" required />
                    <label asp-for="Email"><i class="bi bi-envelope text-muted me-1"></i> Email</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-2">
                    <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Password" required />
                    <label asp-for="Password"><i class="bi bi-lock text-muted me-1"></i> Password</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
                        <label class="form-check-label text-muted small" for="rememberMe">
                            Keep me signed in
                        </label>
                    </div>
                    <a asp-action="ForgotPassword" class="text-decoration-none fw-semibold small" style="color: #6366f1;">
                        Forgot Password?
                    </a>
                </div>

                <button type="submit" class="btn btn-gradient w-100 py-3 rounded-3 shadow-sm mb-3">
                    Sign In <i class="bi bi-box-arrow-in-right ms-1"></i>
                </button>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
