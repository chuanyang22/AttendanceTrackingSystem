@model AttendanceTrackingSystem.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center align-items-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3 text-white"
                     style="width: 56px; height: 56px; background: linear-gradient(135deg, #ec4899, #8b5cf6); box-shadow: 0 10px 20px rgba(236,72,153,0.3);">
                    <i class="bi bi-person-plus-fill fs-3"></i>
                </div>
                <h3 class="fw-bold tracking-tight">Create an Account</h3>
                <p class="text-muted small">Join the Attendance Tracking Portal</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 rounded-3 py-2 small shadow-sm">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-action="Register" method="post" enctype="multipart/form-data">
                <div class="form-floating mb-3">
                    <input asp-for="FullName" class="form-control rounded-3" placeholder="John Doe" required />
                    <label asp-for="FullName"><i class="bi bi-person text-muted me-1"></i> Full Name</label>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control rounded-3" placeholder="name@example.com" required />
                    <label asp-for="Email"><i class="bi bi-envelope text-muted me-1"></i> Email Address</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Password" required />
                    <label asp-for="Password"><i class="bi bi-lock text-muted me-1"></i> Password</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3" placeholder="Confirm Password" required />
                    <label asp-for="ConfirmPassword"><i class="bi bi-shield-check text-muted me-1"></i> Confirm Password</label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <select asp-for="Role" class="form-select rounded-3">
                        <option value="Admin">Admin (Teacher/Staff)</option>
                        <option value="Student" selected>Student</option>
                    </select>
                    <label asp-for="Role"><i class="bi bi-person-badge text-muted me-1"></i> Account Role</label>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-medium"><i class="bi bi-image me-1"></i> Profile Photo (Optional)</label>
                    <input asp-for="ProfilePicture" type="file" class="form-control rounded-3" accept="image/*" />
                    <span asp-validation-for="ProfilePicture" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-gradient w-100 py-3 rounded-3 shadow-sm mb-3">
                    Complete Registration <i class="bi bi-arrow-right ms-1"></i>
                </button>

                <div class="text-center">
                    <span class="text-muted small">Already registered? </span>
                    <a asp-action="Login" class="text-decoration-none fw-bold small" style="color: #6366f1;">Sign in here</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}