@model AttendanceTrackingSystem.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-md-5">
        <div class="card card-custom p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3 text-white"
                     style="width: 56px; height: 56px; background: linear-gradient(135deg, #10b981, #059669); box-shadow: 0 10px 20px rgba(16,185,129,0.3);">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <h3 class="fw-bold tracking-tight">Set New Password</h3>
                <p class="text-muted small">Enter and confirm your new password for <strong>@Model.Email</strong></p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 rounded-3 py-2 small shadow-sm">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <div class="form-floating mb-3">
                    <input asp-for="NewPassword" type="password" class="form-control rounded-3" placeholder="New Password" required />
                    <label asp-for="NewPassword"><i class="bi bi-lock text-muted me-1"></i> New Password</label>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3" placeholder="Confirm Password" required />
                    <label asp-for="ConfirmPassword"><i class="bi bi-shield-check text-muted me-1"></i> Confirm Password</label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-success w-100 py-3 rounded-3 shadow-sm mb-3">
                    Update Password <i class="bi bi-check-circle ms-1"></i>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}