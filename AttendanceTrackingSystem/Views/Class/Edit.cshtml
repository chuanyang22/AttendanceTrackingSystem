@model AttendanceTrackingSystem.Models.SchoolClass

@{
    ViewData["Title"] = "Edit Class";
}

<h1>Edit Class</h1>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ClassId" />

    <div class="form-group">
        <label asp-for="ClassName"></label>
        <input asp-for="ClassName" class="form-control" />
        <span asp-validation-for="ClassName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Schedule">Schedule</label>
        <div class="d-flex gap-2">
            <select id="scheduleDay" class="form-select">
                <option value="Monday">Monday</option>
                <option value="Tuesday">Tuesday</option>
                <option value="Wednesday">Wednesday</option>
                <option value="Thursday">Thursday</option>
                <option value="Friday">Friday</option>
                <option value="Saturday">Saturday</option>
                <option value="Sunday">Sunday</option>
            </select>
            <select id="scheduleStart" class="form-select">
                @for (int h = 8; h <= 21; h++)
                {
                    <option value="@($"{h:D2}:00")">@((h > 12 ? h - 12 : h)):00 @(h >= 12 ? "PM" : "AM")</option>
                    if (h != 21)
                    {
                        <option value="@($"{h:D2}:30")">@((h > 12 ? h - 12 : h)):30 @(h >= 12 ? "PM" : "AM")</option>
                    }
                }
            </select>
            <span class="align-self-center">to</span>
            <select id="scheduleEnd" class="form-select">
                @for (int h = 8; h <= 21; h++)
                {
                    <option value="@($"{h:D2}:00")">@((h > 12 ? h - 12 : h)):00 @(h >= 12 ? "PM" : "AM")</option>
                    if (h != 21)
                    {
                        <option value="@($"{h:D2}:30")">@((h > 12 ? h - 12 : h)):30 @(h >= 12 ? "PM" : "AM")</option>
                    }
                }
            </select>
        </div>
        <input type="hidden" asp-for="Schedule" id="Schedule" />
        <span asp-validation-for="Schedule" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TeacherId">Assign Teacher</label>
        <select asp-for="TeacherId" class="form-select" asp-items="ViewBag.TeacherId"></select>
        <span asp-validation-for="TeacherId" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var scheduleVal = document.getElementById('Schedule').value;
            if (scheduleVal) {
                var parts = scheduleVal.split(' ');
                if (parts.length === 2) {
                    var day = parts[0];
                    var times = parts[1].split('-');
                    if (times.length === 2) {
                        document.getElementById('scheduleDay').value = day;
                        document.getElementById('scheduleStart').value = times[0];
                        document.getElementById('scheduleEnd').value = times[1];
                    }
                }
            }
        });

        function updateSchedule() {
            var day = document.getElementById('scheduleDay').value;
            var start = document.getElementById('scheduleStart').value;
            var end = document.getElementById('scheduleEnd').value;
            if (start && end) {
                document.getElementById('Schedule').value = day + ' ' + start + '-' + end;
            } else {
                document.getElementById('Schedule').value = '';
            }
        }
        document.getElementById('scheduleDay').addEventListener('change', updateSchedule);
        document.getElementById('scheduleStart').addEventListener('change', updateSchedule);
        document.getElementById('scheduleEnd').addEventListener('change', updateSchedule);
    </script>
}
