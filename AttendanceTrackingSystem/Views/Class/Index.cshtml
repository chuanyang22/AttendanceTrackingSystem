@model IEnumerable<AttendanceTrackingSystem.Models.SchoolClass>

@{
    ViewData["Title"] = "Classes";
}

<h1>Classes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add New Class</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Search by class name or teacher" />
    <button type="submit" class="btn btn-secondary">Search</button>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Class Name</th>
            <th>Schedule</th>
            <th>Teacher</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ClassName</td>
                <td>@item.Schedule</td>
                <td>@item.TeacherName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ClassId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.ClassId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.ClassId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
