@model IEnumerable<AttendanceTrackingSystem.Models.SchoolClass>

@{
    ViewData["Title"] = "Classes";
}

<h1>Classes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add New Class</a>
</p>

<div class="mb-3">
    <input type="text" id="searchBox" class="form-control" value="@ViewData["CurrentFilter"]" placeholder="Search by class name or teacher..." />
</div>

<div id="classTableContainer">
    @await Html.PartialAsync("_ClassTable", Model)
</div>

@section Scripts {
    <script>
        (function() {
            const searchBox = document.getElementById('searchBox');
            const container = document.getElementById('classTableContainer');
            let debounceTimer;

            searchBox.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function() {
                    const query = searchBox.value;
                    const url = '@Url.Action("Index", "Class")' + '?searchString=' + encodeURIComponent(query);

                    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(response => response.text())
                        .then(html => {
                            container.innerHTML = html;
                            const newUrl = query
                                ? '@Url.Action("Index", "Class")' + '?searchString=' + encodeURIComponent(query)
                                : '@Url.Action("Index", "Class")';
                            history.replaceState(null, '', newUrl);
                        })
                        .catch(err => console.error('Search failed:', err));
                }, 300);
            });
        })();
    </script>
}