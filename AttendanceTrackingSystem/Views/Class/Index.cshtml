@model IEnumerable<AttendanceTrackingSystem.Models.SchoolClass>

@{
    ViewData["Title"] = "Classes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Classes</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add New Class
        </a>
    }
</div>

<div class="card card-custom overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Class</th>
                    <th>Schedule</th>
                    <th>Teacher</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ClassName</td>
                            <td>@item.Schedule</td>
                            <td>@item.Teacher?.FullName</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.ClassId" class="btn btn-outline-primary btn-sm rounded-2 me-1">Details</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.ClassId" class="btn btn-outline-secondary btn-sm rounded-2 me-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.ClassId" class="btn btn-outline-danger btn-sm rounded-2">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No classes found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
