@model AttendanceTrackingSystem.Models.SchoolClass

@{
    ViewData["Title"] = "Add Class";
}

<h1>Add Class</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="ClassName"></label>
        <input asp-for="ClassName" class="form-control" />
        <span asp-validation-for="ClassName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ClassType">Class Type</label>
        <select asp-for="ClassType" class="form-select">
            <option value="">-- Select Type --</option>
            <option value="Lecture">Lecture</option>
            <option value="Tutorial">Tutorial</option>
            <option value="Practical">Practical</option>
        </select>
        <span asp-validation-for="ClassType" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Schedule">Schedule</label>
        <div class="d-flex gap-2">
            <select id="scheduleDay" class="form-select">
                <option value="Monday">Monday</option>
                <option value="Tuesday">Tuesday</option>
                <option value="Wednesday">Wednesday</option>
                <option value="Thursday">Thursday</option>
                <option value="Friday">Friday</option>
                <option value="Saturday">Saturday</option>
                <option value="Sunday">Sunday</option>
            </select>
            <select id="scheduleStart" class="form-select">
                @for (int h = 8; h <= 21; h++)
                {
                    <option value="@($"{h:D2}:00")">@((h > 12 ? h - 12 : h)):00 @(h >= 12 ? "PM" : "AM")</option>
                    if (h != 21)
                    {
                        <option value="@($"{h:D2}:30")">@((h > 12 ? h - 12 : h)):30 @(h >= 12 ? "PM" : "AM")</option>
                    }
                }
            </select>
            <span class="align-self-center">to</span>
            <select id="scheduleEnd" class="form-select">
                @for (int h = 8; h <= 21; h++)
                {
                    <option value="@($"{h:D2}:00")">@((h > 12 ? h - 12 : h)):00 @(h >= 12 ? "PM" : "AM")</option>
                    if (h != 21)
                    {
                        <option value="@($"{h:D2}:30")">@((h > 12 ? h - 12 : h)):30 @(h >= 12 ? "PM" : "AM")</option>
                    }
                }
            </select>
        </div>
        <input type="hidden" asp-for="Schedule" id="Schedule" />
        <span asp-validation-for="Schedule" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TeacherId">Assign Teacher</label>
        <select asp-for="TeacherId" class="form-select" asp-items="ViewBag.TeacherId">
            <option value="">-- Select a Teacher --</option>
        </select>
        <span asp-validation-for="TeacherId" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function updateSchedule() {
            var day = document.getElementById('scheduleDay').value;
            var start = document.getElementById('scheduleStart').value;
            var end = document.getElementById('scheduleEnd').value;
            if (start && end) {
                document.getElementById('Schedule').value = day + ' ' + start + '-' + end;
            } else {
                document.getElementById('Schedule').value = '';
            }
        }

        function generateEndTimes() {
            var startStr = document.getElementById('scheduleStart').value;
            if (!startStr) return;

            var startParts = startStr.split(':');
            var startMins = parseInt(startParts[0]) * 60 + parseInt(startParts[1]);
            
            var endSelect = document.getElementById('scheduleEnd');
            var currentEnd = endSelect.value;
            endSelect.innerHTML = '';
            
            // Min 1 hour, max 4 hours
            var minEndMins = startMins + 60;
            var maxEndMins = startMins + 240;
            
            // Limit to 21:00 (9 PM) maximum
            if (maxEndMins > 21 * 60) maxEndMins = 21 * 60;

            for (var m = minEndMins; m <= maxEndMins; m += 30) {
                var h = Math.floor(m / 60);
                var mins = m % 60;
                
                var hStr = (h < 10 ? '0' : '') + h;
                var mStr = (mins === 0 ? '00' : '30');
                var val = hStr + ':' + mStr;
                
                var displayH = h > 12 ? h - 12 : (h === 0 ? 12 : h);
                var ampm = h >= 12 && h < 24 ? 'PM' : 'AM';
                var display = displayH + ':' + mStr + ' ' + ampm;
                
                var option = document.createElement('option');
                option.value = val;
                option.text = display;
                endSelect.appendChild(option);
            }
            
            var validValues = Array.from(endSelect.options).map(o => o.value);
            if (validValues.includes(currentEnd)) {
                endSelect.value = currentEnd;
            } else if (endSelect.options.length > 0) {
                endSelect.selectedIndex = 0;
            }
            
            updateSchedule();
        }

        document.getElementById('scheduleDay').addEventListener('change', updateSchedule);
        document.getElementById('scheduleStart').addEventListener('change', generateEndTimes);
        document.getElementById('scheduleEnd').addEventListener('change', updateSchedule);

        // Run once on load to restrict end times correctly based on initial start time
        generateEndTimes();
    </script>
}


