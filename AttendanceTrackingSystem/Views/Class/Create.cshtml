@model AttendanceTrackingSystem.Models.SchoolClass

@{
    ViewData["Title"] = "Add Class";
}

<h1>Add Class</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="ClassName"></label>
        <input asp-for="ClassName" class="form-control" />
        <span asp-validation-for="ClassName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Schedule"></label>
        <input asp-for="Schedule" class="form-control" placeholder="e.g. Mon/Wed 10:00-11:30" />
        <span asp-validation-for="Schedule" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TeacherName">Assign Teacher</label>
        <input asp-for="TeacherName" class="form-control" placeholder="Teacher's name" />
        <span asp-validation-for="TeacherName" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
