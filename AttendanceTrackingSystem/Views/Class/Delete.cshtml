@model AttendanceTrackingSystem.Models.SchoolClass

@{
    ViewData["Title"] = "Delete Class";
}

<h1>Delete Class</h1>

<h3>Are you sure you want to delete this class?</h3>
<dl class="row">
    <dt class="col-sm-2">Class</dt>
    <dd class="col-sm-10">@Model.ClassName</dd>

    <dt class="col-sm-2">Teacher</dt>
    <dd class="col-sm-10">@Model.Teacher?.FullName</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="ClassId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
