@model IEnumerable<AttendanceTrackingSystem.Models.SchoolClass>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Class</th>
            <th>Schedule</th>
            <th>Teacher</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ClassName</td>
                
                @{
                    string formattedSchedule = "Not Set";
                    if (!string.IsNullOrEmpty(item.Schedule))
                    {
                        var parts = item.Schedule.Split(' ');
                        if (parts.Length > 1)
                        {
                            var day = parts[0];
                            var timePart = string.Join(" ", parts.Skip(1));
                            var times = timePart.Split('-');
                            if (times.Length == 2 && DateTime.TryParse(times[0], out DateTime start) && DateTime.TryParse(times[1], out DateTime end))
                            {
                                formattedSchedule = $"{start:h:mmtt} - {end:h:mmtt} ({day})";
                            }
                            else
                            {
                                formattedSchedule = $"{timePart} ({day})";
                            }
                        }
                        else
                        {
                            formattedSchedule = item.Schedule;
                        }
                    }
                }
                <td>@formattedSchedule</td>
                <td>@item.Teacher?.FullName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ClassId" class="btn btn-sm btn-outline-primary">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.ClassId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.ClassId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No classes found.</td>
            </tr>
        }
    </tbody>
</table>

