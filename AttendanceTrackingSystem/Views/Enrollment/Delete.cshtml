@model AttendanceTrackingSystem.Models.Enrollment

@{
    ViewData["Title"] = "Remove Enrollment";
}

<h1>Remove Enrollment</h1>

<h3>Are you sure you want to remove this student from the class?</h3>
<dl class="row">
    <dt class="col-sm-2">Student</dt>
    <dd class="col-sm-10">@Model.Student?.Name</dd>

    <dt class="col-sm-2">Class</dt>
    <dd class="col-sm-10">@Model.SchoolClass?.ClassName</dd>

    <dt class="col-sm-2">Enroll Date</dt>
    <dd class="col-sm-10">@Model.EnrollDate.ToShortDateString()</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="EnrollmentId" />
    <button type="submit" class="btn btn-danger">Remove</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>