@model AttendanceTrackingSystem.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0">Edit User Details</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="UserId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="text-center mb-4">
                        @{
    var defaultAvatarUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(Model.FullName)}&background=random&color=fff&size=80";
    var avatarToDisplay = string.IsNullOrEmpty(Model.ProfilePictureUrl) ? defaultAvatarUrl : Model.ProfilePictureUrl;
}
                        <img src="@avatarToDisplay"
                             alt="@Model.FullName"
                             class="rounded-circle border mb-2"
                             style="width: 80px; height: 80px; object-fit: cover;" />
                        <div class="small text-muted">Current Avatar</div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                                        <div class="form-group mb-3">
                        <label for="newPassword" class="form-label fw-semibold">New Password (Leave blank to keep unchanged)</label>
                        <div class="input-group">
                            <input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢" onmouseover="hoverPassword()" onmouseout="unhoverPassword()" data-val="true" data-val-minlength="New password must be at least 6 characters." data-val-minlength-min="6" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword()">
                                <i id="toggleIcon" class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span class="text-danger small field-validation-valid" data-valmsg-for="newPassword" data-valmsg-replace="true"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="Student">Student</option>
                            <option value="Teacher">Teacher</option>
                            <option value="Admin">Admin</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label for="profileImage" class="form-label fw-semibold">Change Profile Photo</label>
                        <input type="file" id="profileImage" name="profileImage" class="form-control" accept="image/*" />
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Is Active Account</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">Back</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePassword() {
            var input = document.getElementById("newPassword");
            var icon = document.getElementById("toggleIcon");
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }

        function hoverPassword() {
            // Optional: You can add hover effects here if desired
        }

        function unhoverPassword() {
            // Optional: You can add unhover effects here if desired
        }
    </script>
}



