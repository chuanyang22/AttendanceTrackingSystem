@model IEnumerable<AttendanceTrackingSystem.Models.User>

@{
    var currentRole = ViewData["CurrentRole"]?.ToString();
    ViewData["Title"] = string.IsNullOrEmpty(currentRole) ? "User Management" : $"{currentRole} Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@(string.IsNullOrEmpty(currentRole) ? "User Management" : $"{currentRole} Management")</h2>
    <a asp-action="Create" class="btn btn-primary">Create New User</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        @if (!string.IsNullOrEmpty(currentRole))
        {
            <input type="hidden" name="role" value="@currentRole" />
        }
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by name or email..." />
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i> Search</button>
        @if (ViewData["CurrentFilter"] != null)
        {
            <a asp-action="Index" asp-route-role="@currentRole" class="btn btn-outline-danger">Clear</a>
        }
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;">Avatar</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No users found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(user.ProfilePictureUrl) ? "https://via.placeholder.com/40" : user.ProfilePictureUrl)"
                                         alt="@user.FullName"
                                         class="rounded-circle border"
                                         style="width: 40px; height: 40px; object-fit: cover;" />
                                </td>
                                <td class="fw-semibold">@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge @(user.Role == "Admin" ? "bg-danger" : user.Role == "Teacher" ? "bg-success" : "bg-primary")">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end pe-3">
                                    <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@user.UserId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        setTimeout(function () {
            var alertElement = document.getElementById('successAlert');
            if (alertElement) {
                var bsAlert = new bootstrap.Alert(alertElement);
                bsAlert.close();
            }
        }, 15000);
    </script>
}
