@model IEnumerable<AttendanceTrackingSystem.Models.AttendanceSession>

@{
    ViewData["Title"] = "Attendance Sessions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Attendance Sessions</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="CreateSession" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Create New Attendance Session
        </a>
    }
</div>

<div class="card card-custom overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Class</th>
                    <th>Date</th>
                    <th>Topic</th>
                    <th>Records</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var session in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@(session.SchoolClass?.ClassName ?? "N/A")</td>
                            <td>@session.SessionDate.ToString("yyyy-MM-dd")</td>
                            <td>@session.Topic</td>
                            <td>@(session.AttendanceRecords?.Count ?? 0)</td>
                            <td class="text-end">
                                <a asp-action="Mark" asp-route-id="@session.SessionId" class="btn btn-success btn-sm rounded-2 me-1">
                                    <i class="bi bi-check2-circle me-1"></i> Mark Attendance
                                </a>
                                <a asp-action="QrCode" asp-route-id="@session.SessionId" class="btn btn-outline-dark btn-sm rounded-2">
                                    <i class="bi bi-123 me-1"></i> PIN Code
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No attendance sessions found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>