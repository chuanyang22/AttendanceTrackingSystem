@model IEnumerable<AttendanceTrackingSystem.Models.AttendanceSession>
@{
    ViewData["Title"] = "Attendance Sessions";
}

<h1>Attendance Sessions</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-action="CreateSession" class="btn btn-primary">+ Create New Attendance Session</a>
</p>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <select name="classId" class="form-select" asp-items="ViewBag.ClassId" onchange="this.form.submit()">
            <option value="">-- All Classes --</option>
        </select>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Class</th>
            <th>Date</th>
            <th>Topic</th>
            <th>Enrolled / Records</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SchoolClass?.ClassName</td>
                <td>@item.SessionDate.ToString("yyyy-MM-dd")</td>
                <td>@(string.IsNullOrEmpty(item.Topic) ? "-" : item.Topic)</td>
                <td>@item.AttendanceRecords.Count</td>
                <td>
                    <a asp-action="Mark" asp-route-id="@item.SessionId" class="btn btn-sm btn-success">Mark Attendance</a>
                    <a asp-action="QRCode" asp-route-id="@item.SessionId" class="btn btn-sm btn-outline-dark">QR Code</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No attendance sessions found.</td>
            </tr>
        }
    </tbody>
</table>