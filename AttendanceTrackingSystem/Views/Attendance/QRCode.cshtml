@model AttendanceTrackingSystem.Models.AttendanceSession
@{
    ViewData["Title"] = "Attendance PIN Code";
    int presentCount = Model.AttendanceRecords?.Count(r => r.Status == "Present") ?? 0;
    int totalCount = Model.SchoolClass?.Enrollments?.Count ?? (Model.AttendanceRecords?.Count ?? 0);
}

<div class="row justify-content-center py-4">
    <div class="col-md-9 col-lg-8">
        <div class="card card-custom p-4 p-md-5 text-center shadow-lg border-0">
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show text-start mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="mb-3">
                <span class="badge bg-primary px-3 py-2 fs-6 rounded-pill text-uppercase">
                    <i class="bi bi-shield-lock me-1"></i> Live Attendance Code
                </span>
            </div>

            <h1 class="fw-bold text-dark mb-1">@Model.SchoolClass?.ClassName</h1>
            <p class="text-muted fs-5 mb-4">
                <span class="badge bg-secondary me-2">@Model.SessionType</span>
                <i class="bi bi-calendar3 me-1"></i> @Model.SessionDate.ToString("dd MMMM yyyy (dddd)")
                @if (Model.StartTime.HasValue && Model.EndTime.HasValue)
                {
                    <span> | <i class="bi bi-clock me-1"></i> @(DateTime.Today.Add(Model.StartTime.Value).ToString("h:mm tt")) - @(DateTime.Today.Add(Model.EndTime.Value).ToString("h:mm tt"))</span>
                }
            </p>

            <!-- QR Code & PIN Display Row -->
            <div class="row g-4 my-3">
                <!-- QR Code Box -->
                <div class="col-md-6">
                    <div class="bg-light p-4 rounded-4 border border-2 h-100 d-flex flex-column justify-content-center align-items-center">
                        <div class="text-muted text-uppercase fw-semibold small mb-3">Scan to get PIN</div>
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@Model.QRCodeToken" 
                             alt="QR Code" 
                             class="img-fluid border p-2 bg-white rounded-3 shadow-sm mb-3" 
                             style="width: 200px; height: 200px;" />
                        <div class="text-muted small">
                            <i class="bi bi-camera me-1"></i> Point your phone camera here
                        </div>
                    </div>
                </div>

                <!-- 6-Digit PIN Box -->
                <div class="col-md-6">
                    <div class="bg-light p-4 rounded-4 border border-2 h-100 d-flex flex-column justify-content-center position-relative">
                        <div class="text-muted text-uppercase fw-semibold small mb-2">6-Digit Check-In PIN</div>
                        
                        <div id="pinDisplay" class="display-3 fw-bolder text-primary tracking-widest my-3 font-monospace" style="letter-spacing: 8px; text-shadow: 0 2px 4px rgba(99,102,241,0.15);">
                            @Model.QRCodeToken
                        </div>

                        <div class="d-flex justify-content-center gap-2 mt-auto">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyPinCode('@Model.QRCodeToken')">
                                <i class="bi bi-clipboard me-1"></i> Copy Code
                            </button>

                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-controller="Attendance" asp-action="RegenerateCode" asp-route-id="@Model.SessionId" method="post" class="d-inline" onsubmit="return confirm('Generate a new random 6-digit PIN? The previous code will no longer work.');">
                                    <button type="submit" class="btn btn-outline-warning text-dark btn-sm fw-semibold">
                                        <i class="bi bi-arrow-repeat me-1"></i> New PIN
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
</div>

@section Scripts {
    <script>
        function copyPinCode(pin) {
            navigator.clipboard.writeText(pin).then(() => {
                alert("PIN Code " + pin + " copied to clipboard!");
            }).catch(() => {
                prompt("Copy PIN Code:", pin);
            });
        }
    </script>
}

