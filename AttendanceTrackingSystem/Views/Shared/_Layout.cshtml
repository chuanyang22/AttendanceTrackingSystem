<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ATS Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .navbar-brand-gradient {
            background: linear-gradient(135deg, #818cf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
            font-size: 1.35rem;
            letter-spacing: -0.5px;
        }

        .nav-link {
            font-weight: 500;
            color: #94a3b8 !important;
            transition: all 0.2s ease;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
        }

            .nav-link:hover, .nav-link.active {
                color: #ffffff !important;
                background: rgba(255, 255, 255, 0.08);
            }

        .dropdown-menu {
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: #1e293b;
        }

        .dropdown-item {
            color: #cbd5e1;
            font-size: 0.9rem;
            padding: 0.6rem 1rem;
            border-radius: 6px;
        }

            .dropdown-item:hover {
                background: rgba(255, 255, 255, 0.1);
                color: #ffffff;
            }

        .btn-gradient {
            background: var(--primary-gradient);
            color: #fff;
            border: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .card-custom {
            border: none;
            border-radius: 16px;
            box-shadow: var(--card-shadow);
            background: #ffffff;
        }

        footer {
            margin-top: auto;
            border-top: 1px solid #e2e8f0;
            background: #ffffff;
            color: #64748b;
            font-size: 0.875rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                    <span class="d-inline-flex p-2 rounded-3 bg-primary text-white">
                        <i class="bi bi-shield-check"></i>
                    </span>
                    <span class="navbar-brand-gradient">ATS Portal</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Dashboard -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-1"></i> Dashboard
                                </a>
                            </li>

                            <!-- 1. ADMIN ONLY: Users Management & Student Profiles -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="User" asp-action="Index">
                                        <i class="bi bi-people me-1"></i> Users
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="Index">
                                        <i class="bi bi-mortarboard me-1"></i> Students
                                    </a>
                                </li>
                            }

                            <!-- 2. BOTH ADMIN/TEACHER & STUDENTS: Classes & Attendance Sessions -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Class" asp-action="Index">
                                    <i class="bi bi-collection me-1"></i> Classes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Attendance" asp-action="Index">
                                    <i class="bi bi-check2-circle me-1"></i> Attendance
                                </a>
                            </li>

                            <!-- 3. REPORTS -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="reportsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-bar-chart-line me-1"></i> Reports
                                    </a>
                                    <ul class="dropdown-menu shadow-lg p-2" aria-labelledby="reportsDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-controller="AttendanceReport" asp-action="ClassReport">
                                                <i class="bi bi-table me-2"></i> Class Monthly Report
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="AttendanceReport" asp-action="StudentHistory">
                                                <i class="bi bi-person-lines-fill me-2"></i> All Students History
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AttendanceReport" asp-action="StudentHistory">
                                        <i class="bi bi-clock-history me-1"></i> My History
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var avatarClaim = User.FindFirst("ProfilePicture")?.Value;
                            var avatarUrl = !string.IsNullOrEmpty(avatarClaim) ? avatarClaim : "https://api.dicebear.com/7.x/initials/svg?seed=" + User.Identity.Name;

                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center text-white py-1 px-2 border border-secondary rounded-pill me-2 bg-dark"
                                   asp-controller="Account" asp-action="EditProfile" title="Click to customize profile">
                                    <img src="@avatarUrl" class="rounded-circle border border-primary me-2" style="width: 28px; height: 28px; object-fit: cover;" alt="Avatar" />
                                    <span class="fw-semibold small me-2">@User.Identity.Name</span>
                                    <i class="bi bi-pencil-square text-info small"></i>
                                </a>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-gradient btn-sm rounded-pill px-3 py-2" asp-controller="Account" asp-action="Register">Get Started</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 Attendance Tracking System • Engineered for Clarity
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>